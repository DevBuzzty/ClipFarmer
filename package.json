{
  "name": "twitch-viral-clip-automator",
  "version": "2.0.0",
  "description": "Premium AI-powered Twitch VOD clip automator",
  "main": "frontend/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-backend": "python -m PyInstaller --noconfirm --distpath frontend/backend_dist backend.spec",
    "dist": "npm run build-backend && npm run build"
  },
  "build": {
    "appId": "com.twitch.viral.clip.automator",
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "extraResources": [
      {
        "from": "frontend/backend_dist/app",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
